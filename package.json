{
  "name": "ar-gym",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "videos:inventory": "node scripts/inventory.mjs",
    "videos:map": "node scripts/map-videos.mjs",
    "videos:scan": "node scripts/scan-damage.mjs",
    "videos:encode": "node scripts/encode-videos.mjs --crf-exercises 30",
    "videos:finalize": "node scripts/finalize-map.mjs",
    "videos": "npm run videos:inventory && npm run videos:map && npm run videos:scan && npm run videos:encode && npm run videos:finalize",
    "icons": "node scripts/make-icons.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "brand-check": "! grep -rniE 'shadad|shady|شداد|شادي|youtube' dist/ && ! find dist -iname '*shadad*' -o -iname '*shady*' -o -iname '*youtube*' -o -name '*شداد*' -o -name '*شادي*' | grep .",
    "deploy": "npm run build && npm run brand-check && firebase deploy --only hosting"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
